# Server-side (set as Railway runtime env vars)
ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Stripe (server-side, secret)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...   # $9.99 → 50 credits
STRIPE_PRICE_STANDARD=price_...  # $29.99 → 200 credits
STRIPE_PRICE_PRO=price_...       # $79.99 → 700 credits

# Public app URL (used for Stripe success/cancel redirects)
APP_URL=https://your-railway-app.up.railway.app

# Set FREE_MODE=true during private testing to bypass the credit gate.
# Authenticated users get unlimited transforms; buy-credits UI is hidden.
# Unset or set to anything other than "true" for normal credit-gated behavior.
FREE_MODE=true

# Frontend (CRA — must be prefixed REACT_APP_, baked into build)
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOi...
